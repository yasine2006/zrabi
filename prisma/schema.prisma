// ---------------------------------------------------------------------------
// Zarbia Atlas — data model
// PostgreSQL 16 · Prisma ORM
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CLIENT
  ADMIN
  MANAGER
  READONLY
}

enum RugType {
  BENI_OURAIN
  AZILAL
  BOUCHEROUITE
  KILIM
  HANBEL
}

enum RugStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum OrderStatus {
  PENDING
  PENDING_COD
  CONFIRMED_COD
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CASH_COLLECTED
  FAILED
  CANCELLED
  REFUNDED
}

enum CustomOrderStatus {
  NEW
  QUOTED
  DEPOSIT_PENDING
  DEPOSIT_RECEIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
  STRIPE
  CMI
  PAYPAL
}

enum Currency {
  MAD
  EUR
  USD
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String
  firstName              String?
  lastName               String?
  phone                  String?
  role                   Role      @default(CLIENT)
  emailVerifiedAt        DateTime?
  lastLoginAt            DateTime?
  isActive               Boolean   @default(true)
  // Two-factor authentication (TOTP)
  twoFactorEnabled       Boolean   @default(false)
  twoFactorSecret        String?
  twoFactorRecoveryCodes String[]  @default([])
  twoFactorConfirmedAt   DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  orders       Order[]
  customOrders CustomOrder[]
  reviews      Review[]

  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Artisans
// ---------------------------------------------------------------------------

model Artisan {
  id         String   @id @default(cuid())
  slug       String   @unique
  nameFr     String
  nameEn     String
  bioFr      String   @db.Text
  bioEn      String   @db.Text
  village    String
  region     String
  photoUrl   String?
  craftSince Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  rugs Rug[]

  @@index([region])
  @@map("artisans")
}

// ---------------------------------------------------------------------------
// Rugs
// ---------------------------------------------------------------------------

model Rug {
  id             String    @id @default(cuid())
  slug           String    @unique
  sku            String    @unique
  nameFr         String
  nameEn         String
  nameAr         String?
  type           RugType
  widthCm        Int
  lengthCm       Int
  weightKg       Decimal   @db.Decimal(6, 2)
  materialFr     String
  materialEn     String
  materialAr     String?
  originVillage  String
  originRegion   String
  originAr       String?
  craftingDays   Int
  storyFr        String    @db.Text
  storyEn        String    @db.Text
  storyAr        String?   @db.Text
  priceMad       Decimal   @db.Decimal(10, 2)
  priceEur       Decimal   @db.Decimal(10, 2)
  priceUsd       Decimal   @db.Decimal(10, 2)
  stock          Int       @default(1)
  status         RugStatus @default(AVAILABLE)
  reservedUntil  DateTime?
  // Product-page views, used by the admin "most viewed" report.
  viewCount      Int       @default(0)
  // Order currently holding the 15-minute lock, so a late failure webhook
  // can never release a reservation that now belongs to another buyer.
  reservedByOrderId String?
  isMadeToOrder  Boolean   @default(false)
  photos         String[]
  videoUrl       String?
  certificateId  String?   @unique
  artisanId      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  artisan    Artisan     @relation(fields: [artisanId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  reviews    Review[]

  @@index([type, status])
  @@index([status, isMadeToOrder])
  @@index([artisanId])
  @@index([reservedByOrderId])
  @@index([viewCount])
  @@map("rugs")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique // e.g. ZA-2026-000123
  userId            String?
  email             String
  phone             String
  fullName          String
  addressLine1      String
  addressLine2      String?
  city              String
  postalCode        String?
  country           String
  shippingZone      String // MOROCCO | EUROPE | USA_CANADA | MIDDLE_EAST
  status            OrderStatus   @default(PENDING)
  paymentMethod     PaymentMethod @default(COD)
  currency          Currency      @default(MAD)
  exchangeRate      Decimal       @db.Decimal(12, 6) @default(1) // selected currency -> MAD
  subtotal          Decimal       @db.Decimal(12, 2)
  discount          Decimal       @default(0) @db.Decimal(12, 2)
  shippingCost      Decimal       @db.Decimal(12, 2) @default(0)
  totalAmount       Decimal       @db.Decimal(12, 2)
  trackingNumber    String?
  carrier           String?
  customerNote      String?       @db.Text
  adminNote         String?       @db.Text
  paymentReference  String?
  paidAt            DateTime?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([userId])
  @@index([status, createdAt])
  @@index([email])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  rugId        String?
  nameSnapshot String
  sku          String
  unitPrice    Decimal  @db.Decimal(12, 2)
  quantity     Int      @default(1)
  lineTotal    Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rug   Rug?  @relation(fields: [rugId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([rugId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Bespoke commissions
// ---------------------------------------------------------------------------

model CustomOrder {
  id                 String      @id @default(cuid())
  reference          String      @unique // e.g. ZA-CUSTOM-000045
  userId             String?
  fullName           String
  email              String
  phone              String
  rugType            RugType?
  widthCm            Int?
  lengthCm           Int?
  budgetMad          Decimal?    @db.Decimal(12, 2)
  woolColors         String[]    @default([])
  pattern            String?     @db.Text
  description        String      @db.Text
  inspirationPhotos  String[]    @default([])
  status             CustomOrderStatus @default(NEW)
  quotedPriceMad     Decimal?    @db.Decimal(12, 2)
  // 30% deposit requested when the commission is accepted.
  depositMad         Decimal?    @db.Decimal(12, 2)
  depositPaidAt      DateTime?
  currency           Currency    @default(MAD)
  adminNote          String?     @db.Text
  respondedAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status, createdAt])
  @@map("custom_orders")
}

// ---------------------------------------------------------------------------
// Shipping & currency
// ---------------------------------------------------------------------------

model ShippingRate {
  id                String   @id @default(cuid())
  zone              String // MOROCCO | EUROPE | USA_CANADA | MIDDLE_EAST
  minWeightKg       Decimal  @db.Decimal(6, 2)
  maxWeightKg       Decimal  @db.Decimal(6, 2)
  priceMad          Decimal  @db.Decimal(10, 2)
  priceEur          Decimal  @db.Decimal(10, 2)
  priceUsd          Decimal  @db.Decimal(10, 2)
  carrier           String?
  estimatedDaysMin  Int
  estimatedDaysMax  Int
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([zone, minWeightKg])
  @@index([zone, isActive])
  @@map("shipping_rates")
}

model CurrencyRate {
  id        String   @id @default(cuid())
  currency  Currency @unique
  // Units of `currency` obtained for 1 MAD (MAD = 1, EUR = 0.096, USD = 0.105)
  rate      Decimal  @db.Decimal(12, 6)
  source    String?  @default("manual")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("currency_rates")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id          String   @id @default(cuid())
  rugId       String
  userId      String?
  authorName  String
  rating      Int // 1..5, validated at the application layer
  title       String?
  comment     String   @db.Text
  locale      String   @default("fr")
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rug  Rug   @relation(fields: [rugId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([rugId, userId])
  @@index([rugId, isPublished])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Blog
// ---------------------------------------------------------------------------

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleFr     String
  titleEn     String
  titleAr     String?
  excerptFr   String   @db.Text
  excerptEn   String   @db.Text
  excerptAr   String?  @db.Text
  contentFr   String   @db.Text
  contentEn   String   @db.Text
  contentAr   String?  @db.Text
  category    String   @default("guide")
  coverImage  String
  readingMinutes Int   @default(5)
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, publishedAt])
  @@index([slug])
  @@map("blog_posts")
}

// ---------------------------------------------------------------------------
// Newsletter
// ---------------------------------------------------------------------------

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("fr")
  source    String   @default("home")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, createdAt])
  @@map("newsletter_subscribers")
}
