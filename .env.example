# ---------------------------------------------------------------------------
# Zarbia Atlas — environment variables
# Copy this file to .env and replace every placeholder before deploying.
# ---------------------------------------------------------------------------

# Database (matches docker-compose.yml)
DATABASE_URL="postgres://zarbia:zarbia_pass@localhost:55432/zarbia_atlas"
# Host port for docker-compose. The project's docker-compose maps 55432 -> 5432.
POSTGRES_PORT="55432"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="212600000000"
# Storefront locales — FR default, EN and AR implemented with RTL for Arabic.
NEXT_PUBLIC_DEFAULT_LOCALE="fr"
NEXT_PUBLIC_SUPPORTED_LOCALES="fr,en,ar"

# Order page access — HMAC secret for signed /order/[id] links.
# Generate with: openssl rand -hex 32
# Falls back to ADMIN_SESSION_SECRET, then AUTH_SECRET when unset.
ORDER_ACCESS_SECRET="replace-me-with-a-32-byte-hex-secret"

# Admin API — Bearer token for machine clients (all /api/admin/* routes).
# Generate with: openssl rand -hex 32
ADMIN_API_KEY="replace-me-with-a-long-random-token"

# Admin sessions — HMAC secret for the signed HttpOnly cookie.
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET="replace-me-with-a-long-random-session-secret"

# Auth (Auth.js / NextAuth v5) — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-base64-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Two-factor authentication secret encryption — openssl rand -base64 32
TWO_FACTOR_ENCRYPTION_KEY="replace-me-with-a-32-byte-base64-key"

# Seed administrator (role ADMIN, 2FA mandatory).
# Password is re-hashed every time `npm run db:seed` runs.
SEED_ADMIN_EMAIL="admin@zarbia-atlas.ma"
SEED_ADMIN_PASSWORD="change-this-password"
# Base32 TOTP secret. Show the current code with: npm run admin:code
SEED_ADMIN_TOTP_SECRET="JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP"

# Payments — Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Payments — CMI (Morocco)
CMI_MERCHANT_ID="..."
CMI_STORE_KEY="..."
CMI_GATEWAY_URL="https://testpayment.cmi.co.ma/fim/est3Dgate"

# Payments — PayPal
PAYPAL_CLIENT_ID="..."
PAYPAL_CLIENT_SECRET="..."
PAYPAL_MODE="sandbox"

# Transactional email (SMTP). Leave SMTP_HOST empty to skip tracking e-mails.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Zarbia Atlas <hello@zarbia-atlas.ma>"

# WhatsApp Cloud API (Meta). Leave empty to return a manual wa.me link.
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
